#include <stdio.h>
#include <stdlib.h>
#include <omp.h>

#define SEED 35791246

int main() {
    int niter, threads[] = {1, 2, 4, 8};

    printf("Enter number of iterations: ");
    scanf("%d", &niter);

    printf("\nThreads\tTime(s)\t\tPi\n");

    for (int t = 0; t < 4; t++) {
        int count = 0;
        omp_set_num_threads(threads[t]);

        double start = omp_get_wtime();

        #pragma omp parallel
        {
            int local_count = 0;
            unsigned int seed = SEED + omp_get_thread_num();

            #pragma omp for
            for (int i = 0; i < niter; i++) {
                double x = (double)rand() / RAND_MAX;
                double y = (double)rand() / RAND_MAX;

                if (x * x + y * y <= 1)
                    local_count++;
            }

            #pragma omp atomic
            count += local_count;
        }

        double pi = 4.0 * count / niter;
        double time = omp_get_wtime() - start;

        printf("%d\t\t%f\t%g\n", threads[t], time, pi);
    }

    return 0;
}
