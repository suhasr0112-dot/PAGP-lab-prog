
#include <gd.h>
#include <omp.h>
#include <stdio.h>

int main(int argc, char *argv[])
{
    FILE *input = fopen(argv[1], "rb");
    FILE *output = fopen(argv[2], "wb");

    gdImagePtr img = gdImageCreateFromPng(input);

    int w = gdImageSX(img);
    int h = gdImageSY(img);

    gdImagePtr gray = gdImageCreateTrueColor(w, h);

    double start = omp_get_wtime();

    #pragma omp parallel for collapse(2)
    for (int y = 0; y < h; y++)
    {
        for (int x = 0; x < w; x++)
        {
            int c = gdImageGetPixel(img, x, y);

            int r = gdImageRed(img, c);
            int g = gdImageGreen(img, c);
            int b = gdImageBlue(img, c);

            int avg = (r + g + b) / 3;

            gdImageSetPixel(gray, x, y,
                            gdTrueColor(avg, avg, avg));
        }
    }

    gdImagePng(gray, output);

    printf("Time: %f seconds\n", omp_get_wtime() - start);

    gdImageDestroy(img);
    gdImageDestroy(gray);
    fclose(input);
    fclose(output);

    return 0;
}
