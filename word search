#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <omp.h>

int count_word(const char *filename, const char *target)
{
    FILE *file = fopen(filename, "r");
    char word[100];
    int count = 0;

    while (fscanf(file, "%99s", word) == 1)
    {
        for (int i = 0; word[i]!= '\0'; i++)
            word[i] = tolower((unsigned char)word[i]);

        if (strcmp(word, target) == 0)
            count++;
    }

    fclose(file);
    return count;
}

int main(int argc, char *argv[])
{
    const char *words[] = {"lorem", "ipsum", "dolo", "sit", "amet"};
    int counts[5];
    int threads = atoi(argv[1]);

    double start = omp_get_wtime();

    #pragma omp parallel for num_threads(threads)
    for (int i = 0; i < 5; i++)
        counts[i] = count_word("words.txt", words[i]);

    printf("Time: %.6f seconds\n", omp_get_wtime() - start);

    for (int i = 0; i < 5; i++)
        printf("%s: %d\n", words[i], counts[i]);

    return 0;
}
