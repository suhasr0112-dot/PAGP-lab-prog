#include <stdio.h>
#include <stdlib.h>
#include <mpi.h>

#define SEED 3655942
#define ROOT 0

int main(int argc, char *argv[]) {
    MPI_Init(&argc, &argv);

    int rank, size;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    int n = 10000, count = 0, total;
    double start, pi;

    if (rank == ROOT)
        start = MPI_Wtime();

    srand(SEED + rank);

    for (int i = 0; i < n / size; i++) {
        double x = (double)rand() / RAND_MAX;
        double y = (double)rand() / RAND_MAX;

        if (x*x + y*y <= 1)
            count++;
    }

    MPI_Reduce(&count, &total, 1, MPI_INT,
               MPI_SUM, ROOT, MPI_COMM_WORLD);

    if (rank == ROOT) {
        pi = 4.0 * total / n;

        printf("Time: %f seconds\n", MPI_Wtime() - start);
        printf("No. of processes: %d\n", size);
        printf("No. of trials: %d\n", n);
        printf("Estimated pi: %f\n", pi);
    }

    MPI_Finalize();
    return 0;
}
