
#include <mpi.h>
#include <stdio.h>
#include <string.h>

int main(int argc, char *argv[])
{
    char *messages[] = {"", "HELLO", "CSE", "RVCE"};
    MPI_Init(&argc, &argv);

    int rank, size;
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    if (rank == 0)
    {
        char msg[32];

        for (int i = 1; i < size; i++)
        {
            MPI_Recv(msg, 32, MPI_CHAR, i, 0,
                     MPI_COMM_WORLD, MPI_STATUS_IGNORE);

            printf("Process %d sent: %s\n", i, msg);
        }
    }
    else
    {
        MPI_Send(messages[rank], strlen(messages[rank]) + 1,
                 MPI_CHAR, 0, 0, MPI_COMM_WORLD);
    }

    MPI_Finalize();

    return 0;
}
